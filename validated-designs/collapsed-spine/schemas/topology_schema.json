{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collapsed-spine/topology",
  "title": "Collapsed-Spine Topology Input",
  "description": "Defines the physical topology for a collapsed-spine EVPN VXLAN fabric. Two collapsed-spines act as EVPN leaves; ToRs are onboarded L2-only edge devices that stay out of the Fabric CR.",
  "type": "object",
  "required": [
    "design",
    "fabric_name",
    "underlay",
    "collapsed_spines",
    "tors",
    "isl_links"
  ],
  "additionalProperties": false,
  "properties": {
    "design": {
      "type": "string",
      "const": "collapsed-spine",
      "description": "Design identifier \u2014 must be 'collapsed-spine'."
    },
    "fabric_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Fabric name used as a prefix for generated resources."
    },
    "environment": {
      "type": "string",
      "enum": [
        "containerlab",
        "physical"
      ],
      "default": "containerlab"
    },
    "credentials": {
      "$ref": "#/$defs/credentials"
    },
    "mgmt_subnet": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
    },
    "underlay": {
      "type": "object",
      "required": [
        "collapsed_spine_asn_start",
        "system0_prefix"
      ],
      "additionalProperties": false,
      "properties": {
        "collapsed_spine_asn_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Starting BGP AS number for collapsed-spines (incremented per device)."
        },
        "system0_prefix": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
          "description": "IPv4 prefix for system0 loopback allocation."
        }
      }
    },
    "collapsed_spines": {
      "$ref": "#/$defs/nodeGroup",
      "description": "Collapsed-spine node group (dual-role EVPN leaves)."
    },
    "tors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/torNode"
      },
      "description": "Explicit list of ToR nodes (heterogeneous platforms allowed)."
    },
    "isl_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/islLink"
      },
      "description": "Explicit ISL list \u2014 no full-mesh auto-generation."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeOverride"
      }
    },
    "edge_interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edgeInterface"
      }
    },
    "lags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lag"
      }
    },
    "default_mtu": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/defaultMtu"
      }
    },
    "banners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/banner"
      }
    },
    "prefix_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prefixSet"
      }
    },
    "fabric_export_policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fabric_import_policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eda": {
      "$ref": "#/$defs/eda"
    },
    "extras": {
      "$ref": "#/$defs/extras"
    }
  },
  "$defs": {
    "credentials": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/credentials"
    },
    "eda": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/eda"
    },
    "extras": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/extras"
    },
    "labels": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/labels"
    },
    "nodeGroup": {
      "type": "object",
      "required": [
        "count",
        "platform",
        "version",
        "mgmt_base_ipv4"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "platform": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mgmt_base_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "name_template": {
          "type": "string",
          "pattern": ".*\\{i[^}]*\\}.*"
        }
      }
    },
    "torNode": {
      "type": "object",
      "required": [
        "name",
        "platform",
        "version",
        "mgmt_ipv4"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "platform": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mgmt_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "islLink": {
      "type": "object",
      "required": [
        "local_node",
        "local_interface",
        "remote_node",
        "remote_interface"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "local_node": {
          "type": "string"
        },
        "local_interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+(-[0-9]+)?$"
        },
        "remote_node": {
          "type": "string"
        },
        "remote_interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+(-[0-9]+)?$"
        }
      }
    },
    "nodeOverride": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mgmt_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "edgeInterface": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/edgeInterface"
    },
    "lag": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/lag"
    },
    "defaultMtu": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/defaultMtu"
    },
    "banner": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/banner"
    },
    "prefixSet": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/prefixSet"
    },
    "configlet": {
      "$ref": "https://nvd.nokia.com/schemas/common/topology-defs#/$defs/configlet"
    }
  }
}
