{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collapsed-spine/topology.fragment",
  "title": "Collapsed-Spine Topology Input (fragment)",
  "description": "Defines the physical topology for a collapsed-spine EVPN VXLAN fabric. Two collapsed-spines act as EVPN leaves; ToRs are onboarded L2-only edge devices that stay out of the Fabric CR. Fragment variant: top-level required keys removed so individual fragments under inputs/*.d/ validate cleanly. The merged result is still validated against the strict schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "design": {
      "type": "string",
      "const": "collapsed-spine",
      "description": "Design identifier \u2014 must be 'collapsed-spine'."
    },
    "fabric_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Fabric name used as a prefix for generated resources."
    },
    "environment": {
      "type": "string",
      "enum": [
        "containerlab",
        "physical"
      ],
      "default": "containerlab"
    },
    "credentials": {
      "$ref": "#/$defs/credentials"
    },
    "mgmt_subnet": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
    },
    "underlay": {
      "type": "object",
      "required": [
        "collapsed_spine_asn_start",
        "system0_prefix"
      ],
      "additionalProperties": false,
      "properties": {
        "collapsed_spine_asn_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Starting BGP AS number for collapsed-spines (incremented per device)."
        },
        "system0_prefix": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
          "description": "IPv4 prefix for system0 loopback allocation."
        }
      }
    },
    "collapsed_spines": {
      "$ref": "#/$defs/nodeGroup",
      "description": "Collapsed-spine node group (dual-role EVPN leaves)."
    },
    "tors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/torNode"
      },
      "description": "Explicit list of ToR nodes (heterogeneous platforms allowed)."
    },
    "isl_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/islLink"
      },
      "description": "Explicit ISL list \u2014 no full-mesh auto-generation."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeOverride"
      }
    },
    "edge_interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edgeInterface"
      }
    },
    "lags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lag"
      }
    },
    "default_mtu": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/defaultMtu"
      }
    },
    "banners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/banner"
      }
    },
    "prefix_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prefixSet"
      }
    },
    "fabric_export_policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fabric_import_policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eda": {
      "$ref": "#/$defs/eda"
    },
    "extras": {
      "$ref": "#/$defs/extras"
    }
  },
  "$defs": {
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "description": "Device credentials used for node onboarding and by generated artefacts (clab, Ansible, gnmic).",
      "properties": {
        "username": {
          "type": "string",
          "default": "admin",
          "description": "Device username."
        },
        "password": {
          "type": "string",
          "default": "NokiaSrl1!",
          "description": "Device password."
        }
      }
    },
    "eda": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_profile": {
          "type": "string",
          "description": "EDA NodeProfile name for node onboarding."
        },
        "namespace": {
          "type": "string",
          "default": "eda",
          "description": "EDA namespace for all resources."
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "description": "Unconstrained topology additions that supplement a locked design. Resources here are labeled nvd-design:extras.",
      "properties": {
        "configlets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configlet"
          },
          "description": "Additional or override configlets (raw SR Linux config patches)."
        }
      }
    },
    "labels": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_./-]+$": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Kubernetes-style label key/value pairs."
    },
    "nodeGroup": {
      "type": "object",
      "required": [
        "count",
        "platform",
        "version",
        "mgmt_base_ipv4"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "platform": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mgmt_base_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "name_template": {
          "type": "string",
          "pattern": ".*\\{i[^}]*\\}.*"
        }
      }
    },
    "torNode": {
      "type": "object",
      "required": [
        "name",
        "platform",
        "version",
        "mgmt_ipv4"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "platform": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mgmt_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "islLink": {
      "type": "object",
      "required": [
        "local_node",
        "local_interface",
        "remote_node",
        "remote_interface"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "local_node": {
          "type": "string"
        },
        "local_interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+(-[0-9]+)?$"
        },
        "remote_node": {
          "type": "string"
        },
        "remote_interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+(-[0-9]+)?$"
        }
      }
    },
    "nodeOverride": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mgmt_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "edgeInterface": {
      "type": "object",
      "required": [
        "name",
        "node",
        "interface",
        "encap"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique interface resource name."
        },
        "node": {
          "type": "string",
          "description": "Node this interface belongs to."
        },
        "interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+$",
          "description": "Physical interface name (e.g. 'ethernet-1-3')."
        },
        "encap": {
          "type": "string",
          "enum": [
            "dot1q",
            "null"
          ],
          "description": "Encapsulation type."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "lag": {
      "type": "object",
      "required": [
        "name",
        "type",
        "mode",
        "min_links",
        "lacp",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique LAG resource name."
        },
        "type": {
          "type": "string",
          "enum": [
            "lacp"
          ],
          "description": "LAG type."
        },
        "mode": {
          "type": "string",
          "enum": [
            "all-active",
            "port-active"
          ],
          "description": "ESI multi-homing mode."
        },
        "min_links": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum active links."
        },
        "revertive": {
          "type": "boolean",
          "description": "Enable revertive behavior (port-active only)."
        },
        "preferred_active_node": {
          "type": "string",
          "description": "Preferred active node for port-active LAGs."
        },
        "standby_signaling": {
          "type": "string",
          "enum": [
            "lacp"
          ],
          "description": "Standby signaling method."
        },
        "lacp": {
          "type": "object",
          "required": [
            "interval",
            "system_id_mac",
            "system_priority"
          ],
          "additionalProperties": false,
          "properties": {
            "interval": {
              "type": "string",
              "enum": [
                "fast",
                "slow"
              ],
              "description": "LACP PDU interval."
            },
            "system_id_mac": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$",
              "description": "LACP system ID MAC address."
            },
            "system_priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "description": "LACP system priority."
            },
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "static"
                  ],
                  "description": "LACP fallback mode."
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Fallback timeout in seconds."
                }
              }
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "node",
              "interface",
              "aggregate_id"
            ],
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "description": "Member node name."
              },
              "interface": {
                "type": "string",
                "description": "Member interface name."
              },
              "aggregate_id": {
                "type": "string",
                "description": "LAG aggregate ID."
              }
            }
          },
          "description": "LAG member interfaces."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "reload_delay_timer": {
          "type": "integer",
          "minimum": 0,
          "description": "Reload delay timer in seconds."
        }
      }
    },
    "defaultMtu": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique DefaultMTU resource name."
        },
        "interface_mtu": {
          "type": "integer",
          "minimum": 1500,
          "maximum": 11000,
          "description": "Default MTU for Ethernet interfaces (includes Ethernet headers, excludes 4-byte FCS trailer)."
        },
        "layer2_subif_mtu": {
          "type": "integer",
          "minimum": 1500,
          "maximum": 11000,
          "description": "Default MTU for Layer 2 (bridged) sub-interfaces."
        },
        "layer3_mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 11000,
          "description": "Default IP MTU for Layer 3 interfaces."
        },
        "node_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label selector to select nodes on which to configure the defaults."
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit list of nodes on which to configure the defaults."
        }
      }
    },
    "banner": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique Banner resource name."
        },
        "login_banner": {
          "type": "string",
          "description": "Login banner displayed before a user has logged into the node."
        },
        "motd": {
          "type": "string",
          "description": "Message of the Day displayed after a user has logged into the node."
        },
        "node_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label selector to select nodes on which to configure the banners."
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit list of nodes on which to configure the banners."
        }
      }
    },
    "prefixSet": {
      "type": "object",
      "required": [
        "name",
        "prefixes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique prefix-set name."
        },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ip_prefix"
            ],
            "additionalProperties": false,
            "properties": {
              "ip_prefix": {
                "type": "string",
                "description": "IPv4 or IPv6 prefix in CIDR notation."
              },
              "mask_length_range": {
                "type": "string",
                "default": "exact",
                "description": "Mask-length range (e.g. '32..32', 'exact')."
              }
            }
          }
        }
      }
    },
    "configlet": {
      "type": "object",
      "required": [
        "name",
        "configs"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Configlet resource name."
        },
        "endpoint_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label selectors to match target nodes."
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit list of target node names."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 100,
          "description": "Configlet priority (higher = applied later)."
        },
        "configs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "operation",
              "config"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "JSON path in the SR Linux YANG model."
              },
              "operation": {
                "type": "string",
                "enum": [
                  "Create",
                  "Update",
                  "Delete"
                ],
                "description": "Config operation type."
              },
              "config": {
                "type": "string",
                "description": "JSON config payload as a string."
              }
            }
          }
        }
      }
    }
  }
}
