{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "3-stage-evpn-vxlan/topology.fragment",
  "title": "3-Stage EVPN VXLAN Topology Input (fragment)",
  "description": "Defines the physical topology for a 3-stage Clos fabric with EVPN VXLAN overlay. Fragment variant: top-level required keys removed so individual fragments under inputs/*.d/ validate cleanly. The merged result is still validated against the strict schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "design": {
      "type": "string",
      "const": "3-stage-evpn-vxlan",
      "description": "Design identifier \u2014 must be '3-stage-evpn-vxlan'."
    },
    "fabric_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Fabric name used as a prefix for generated resources."
    },
    "environment": {
      "type": "string",
      "enum": [
        "containerlab",
        "physical"
      ],
      "default": "containerlab",
      "description": "Deployment environment."
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "description": "Device credentials for node onboarding and Ansible connections. Defaults to admin/NokiaSrl1!.",
      "properties": {
        "username": {
          "type": "string",
          "default": "admin",
          "description": "Device username."
        },
        "password": {
          "type": "string",
          "default": "NokiaSrl1!",
          "description": "Device password."
        }
      }
    },
    "mgmt_subnet": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
      "description": "Management subnet CIDR for containerlab (e.g. '172.21.21.0/16'). Defaults to /24 derived from node mgmt IPs."
    },
    "underlay": {
      "type": "object",
      "required": [
        "spine_asn",
        "leaf_asn_start",
        "system0_prefix"
      ],
      "additionalProperties": false,
      "properties": {
        "spine_asn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "BGP AS number for all spine nodes."
        },
        "leaf_asn_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Starting BGP AS number for leaf nodes (incremented per leaf)."
        },
        "system0_prefix": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
          "description": "IPv4 prefix for system0 loopback allocation (e.g. 192.0.2.0/24)."
        }
      }
    },
    "spines": {
      "$ref": "#/$defs/nodeGroup",
      "description": "Spine node group definition."
    },
    "leafs": {
      "$ref": "#/$defs/nodeGroup",
      "description": "Leaf node group definition."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeOverride"
      },
      "description": "Per-node overrides for auto-generated nodes. Each entry matches a node by name and overrides specific properties."
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/linkOverride"
      },
      "description": "Per-link overrides for auto-generated ISLs. Each entry matches the auto-allocated link by its (leaf, spine) node pair (orientation-agnostic) and overrides the interface allocation. Only valid leaf\u2194spine pairs are accepted."
    },
    "edge_interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edgeInterface"
      },
      "description": "Server-facing (edge) interfaces."
    },
    "lags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lag"
      },
      "description": "LAG (Link Aggregation Group) interfaces."
    },
    "default_mtu": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/defaultMtu"
      },
      "description": "Default MTU settings for fabric nodes."
    },
    "banners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/banner"
      },
      "description": "Login and MOTD banner settings for fabric nodes."
    },
    "prefix_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prefixSet"
      },
      "description": "Prefix sets referenced by routing policies. Overrides design-generated 'prefixset-{fabric_name}' when a name matches."
    },
    "fabric_export_policies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of routing policies to attach to the fabric's default eBGP group as export policies. Defaults to the design-generated 'ebgp-isl-export-policy-{fabric_name}'."
    },
    "fabric_import_policies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of routing policies to attach to the fabric's default eBGP group as import policies. Defaults to the design-generated 'ebgp-isl-import-policy-{fabric_name}'."
    },
    "eda": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_profile": {
          "type": "string",
          "description": "EDA NodeProfile name for node onboarding."
        },
        "namespace": {
          "type": "string",
          "default": "eda",
          "description": "EDA namespace for all resources."
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "description": "Unconstrained additions that supplement the locked design. Resources here are labeled nvd-design:extras.",
      "properties": {
        "configlets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configlet"
          },
          "description": "Additional or override configlets (raw SR Linux config patches)."
        }
      }
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_./-]+$": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Kubernetes-style label key/value pairs."
    },
    "nodeGroup": {
      "type": "object",
      "required": [
        "count",
        "platform",
        "version",
        "mgmt_base_ipv4"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "Number of nodes in this group."
        },
        "platform": {
          "type": "string",
          "description": "Nokia SR Linux platform model (e.g. '7220 IXR-D3L')."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "SR Linux software version (e.g. '24.10.2')."
        },
        "mgmt_base_ipv4": {
          "type": "string",
          "format": "ipv4",
          "description": "Base management IPv4 address (incremented per node)."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "name_template": {
          "type": "string",
          "pattern": ".*\\{i[^}]*\\}.*",
          "description": "Node name template with {i} placeholder for the sequence number. Supports Python format specs for leading zeros (e.g. leaf{i:02}). Defaults to leaf{i} / spine{i}."
        },
        "breakouts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "port_range",
              "mode"
            ],
            "properties": {
              "port_range": {
                "type": "string",
                "description": "Port range for breakout (e.g. '1-32')."
              },
              "mode": {
                "type": "string",
                "description": "Breakout mode (e.g. '4x10G', '4x25G')."
              }
            }
          },
          "description": "Port breakout configuration."
        }
      }
    },
    "nodeOverride": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "description": "Name of the auto-generated node to override (must match a name produced by the name_template)."
        },
        "platform": {
          "type": "string",
          "description": "Override platform model for this node."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Override SR Linux version for this node."
        },
        "mgmt_ipv4": {
          "type": "string",
          "format": "ipv4",
          "description": "Override management IPv4 address for this node."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "linkOverride": {
      "type": "object",
      "required": [
        "local_node",
        "local_interface",
        "remote_node",
        "remote_interface"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Optional link resource name. Defaults to '{leaf}-{spine}' (matching the auto-allocated link name)."
        },
        "local_node": {
          "type": "string",
          "description": "Local node name. Must be one endpoint of an auto-allocated leaf\u2194spine pair."
        },
        "local_interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+(-[0-9]+)?$",
          "description": "Override local interface (supports breakout syntax 'ethernet-X-Y-Z')."
        },
        "remote_node": {
          "type": "string",
          "description": "Remote node name. Must be the other endpoint of an auto-allocated leaf\u2194spine pair."
        },
        "remote_interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+(-[0-9]+)?$",
          "description": "Override remote interface (supports breakout syntax 'ethernet-X-Y-Z')."
        }
      }
    },
    "edgeInterface": {
      "type": "object",
      "required": [
        "name",
        "node",
        "interface",
        "encap"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique interface resource name."
        },
        "node": {
          "type": "string",
          "description": "Node this interface belongs to."
        },
        "interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+$",
          "description": "Physical interface name (e.g. 'ethernet-1-3')."
        },
        "encap": {
          "type": "string",
          "enum": [
            "dot1q",
            "null"
          ],
          "description": "Encapsulation type."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "lag": {
      "type": "object",
      "required": [
        "name",
        "type",
        "mode",
        "min_links",
        "lacp",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique LAG resource name."
        },
        "type": {
          "type": "string",
          "enum": [
            "lacp"
          ],
          "description": "LAG type."
        },
        "mode": {
          "type": "string",
          "enum": [
            "all-active",
            "port-active"
          ],
          "description": "ESI multi-homing mode."
        },
        "min_links": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum active links."
        },
        "revertive": {
          "type": "boolean",
          "description": "Enable revertive behavior (port-active only)."
        },
        "preferred_active_node": {
          "type": "string",
          "description": "Preferred active node for port-active LAGs."
        },
        "standby_signaling": {
          "type": "string",
          "enum": [
            "lacp"
          ],
          "description": "Standby signaling method."
        },
        "lacp": {
          "type": "object",
          "required": [
            "interval",
            "system_id_mac",
            "system_priority"
          ],
          "additionalProperties": false,
          "properties": {
            "interval": {
              "type": "string",
              "enum": [
                "fast",
                "slow"
              ],
              "description": "LACP PDU interval."
            },
            "system_id_mac": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$",
              "description": "LACP system ID MAC address."
            },
            "system_priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "description": "LACP system priority."
            },
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "static"
                  ],
                  "description": "LACP fallback mode."
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Fallback timeout in seconds."
                }
              }
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "node",
              "interface",
              "aggregate_id"
            ],
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "description": "Member node name."
              },
              "interface": {
                "type": "string",
                "description": "Member interface name."
              },
              "aggregate_id": {
                "type": "string",
                "description": "LAG aggregate ID."
              }
            }
          },
          "description": "LAG member interfaces."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "reload_delay_timer": {
          "type": "integer",
          "minimum": 0,
          "description": "Reload delay timer in seconds."
        }
      }
    },
    "defaultMtu": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique DefaultMTU resource name."
        },
        "interface_mtu": {
          "type": "integer",
          "minimum": 1500,
          "maximum": 11000,
          "description": "Default MTU for Ethernet interfaces (includes Ethernet headers, excludes 4-byte FCS trailer)."
        },
        "layer2_subif_mtu": {
          "type": "integer",
          "minimum": 1500,
          "maximum": 11000,
          "description": "Default MTU for Layer 2 (bridged) sub-interfaces."
        },
        "layer3_mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 11000,
          "description": "Default IP MTU for Layer 3 interfaces."
        },
        "node_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label selector to select nodes on which to configure the defaults."
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit list of nodes on which to configure the defaults."
        }
      }
    },
    "banner": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique Banner resource name."
        },
        "login_banner": {
          "type": "string",
          "description": "Login banner displayed before a user has logged into the node."
        },
        "motd": {
          "type": "string",
          "description": "Message of the Day displayed after a user has logged into the node."
        },
        "node_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label selector to select nodes on which to configure the banners."
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit list of nodes on which to configure the banners."
        }
      }
    },
    "prefixSet": {
      "type": "object",
      "required": [
        "name",
        "prefixes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique prefix-set name."
        },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ip_prefix"
            ],
            "additionalProperties": false,
            "properties": {
              "ip_prefix": {
                "type": "string",
                "description": "IPv4 or IPv6 prefix in CIDR notation."
              },
              "mask_length_range": {
                "type": "string",
                "default": "exact",
                "description": "Mask-length range (e.g. '32..32', 'exact')."
              }
            }
          }
        }
      }
    },
    "configlet": {
      "type": "object",
      "required": [
        "name",
        "configs"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Configlet resource name."
        },
        "endpoint_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label selectors to match target nodes."
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit list of target node names."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 100,
          "description": "Configlet priority (higher = applied later)."
        },
        "configs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "operation",
              "config"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "JSON path in the SR Linux YANG model."
              },
              "operation": {
                "type": "string",
                "enum": [
                  "Create",
                  "Update",
                  "Delete"
                ],
                "description": "Config operation type."
              },
              "config": {
                "type": "string",
                "description": "JSON config payload as a string."
              }
            }
          }
        }
      }
    }
  }
}
