{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "3-stage-evpn-vxlan/services",
  "title": "3-Stage EVPN VXLAN Services Input",
  "description": "Defines overlay services for a 3-stage EVPN VXLAN fabric: bridge domains, routers, IRBs, VLANs, routed interfaces, and static routes.",
  "type": "object",
  "required": [
    "bridge_domains",
    "routers"
  ],
  "additionalProperties": false,
  "properties": {
    "bridge_domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bridgeDomain"
      },
      "description": "MAC-VRF bridge domains."
    },
    "routers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/router"
      },
      "description": "IP-VRF routers."
    },
    "irb_interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/irbInterface"
      },
      "description": "IRB interfaces binding bridge domains to routers."
    },
    "vlans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vlan"
      },
      "description": "VLAN services attaching bridge domains to interfaces."
    },
    "routed_interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routedInterface"
      },
      "description": "L3 routed interfaces."
    },
    "static_routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/staticRoute"
      },
      "description": "Static route entries."
    },
    "routing_policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routingPolicy"
      },
      "description": "Routing policies attached to the fabric eBGP group. Overrides design-generated 'ebgp-isl-export/import-policy-{fabric_name}' when a name matches."
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "description": "Unconstrained additions/overrides that supplement the design. Resources here are labeled nvd-design:extras.",
      "properties": {
        "bridge_domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extendedBridgeDomain"
          },
          "description": "Override or add bridge domains with full field access."
        },
        "irb_interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extendedIrbInterface"
          },
          "description": "Override or add IRB interfaces with full field access."
        },
        "routers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extendedRouter"
          },
          "description": "Override or add routers (ip-vrfs) with full field access."
        },
        "vlans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extendedVlan"
          },
          "description": "Override or add VLAN bindings with full field access."
        },
        "routed_interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extendedRoutedInterface"
          },
          "description": "Override or add routed interfaces with full field access."
        },
        "static_routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extendedStaticRoute"
          },
          "description": "Override or add static routes with full field access."
        }
      }
    }
  },
  "$defs": {
    "bridgeDomain": {
      "type": "object",
      "required": [
        "name",
        "vni",
        "evi"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Bridge domain resource name."
        },
        "vni": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777215,
          "description": "VXLAN Network Identifier."
        },
        "evi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "EVPN Instance identifier."
        },
        "export_target": {
          "type": "string",
          "pattern": "^target:.+$",
          "description": "Optional BGP-EVPN export route target (e.g. 'target:1:777'). Overrides the default 'target:1:<evi>'."
        },
        "import_target": {
          "type": "string",
          "pattern": "^target:.+$",
          "description": "Optional BGP-EVPN import route target (e.g. 'target:1:777'). Overrides the default 'target:1:<evi>'."
        }
      }
    },
    "router": {
      "$ref": "https://nvd.nokia.com/schemas/common/services-defs#/$defs/router"
    },
    "irbInterface": {
      "type": "object",
      "required": [
        "name",
        "bridge_domain",
        "router",
        "ipv4"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "IRB interface resource name."
        },
        "bridge_domain": {
          "type": "string",
          "description": "Bridge domain this IRB is bound to (must exist in bridge_domains)."
        },
        "router": {
          "type": "string",
          "description": "Router (IP-VRF) this IRB is bound to (must exist in routers)."
        },
        "ipv4": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
          "description": "IPv4 gateway address with prefix length (e.g. '172.16.10.254/24')."
        },
        "proxy_arp": {
          "type": "boolean",
          "default": true,
          "description": "Enable proxy ARP on this IRB."
        },
        "proxy_nd": {
          "type": "boolean",
          "default": false,
          "description": "Enable proxy ND on this IRB."
        },
        "arp_timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "ARP timeout in seconds."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description for this IRB."
        },
        "ip_mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 9500,
          "description": "IP MTU for this IRB interface. Defaults to layer3_mtu from default_mtu."
        },
        "learn_unsolicited": {
          "type": "string",
          "enum": [
            "NONE",
            "GLOBAL"
          ],
          "default": "NONE",
          "description": "ARP/ND unsolicited learning mode."
        }
      }
    },
    "vlan": {
      "$ref": "https://nvd.nokia.com/schemas/common/services-defs#/$defs/vlan"
    },
    "routedInterface": {
      "type": "object",
      "required": [
        "name",
        "interface",
        "router",
        "vlan_id",
        "ipv4_addresses"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Routed interface resource name."
        },
        "interface": {
          "type": "string",
          "description": "Interface resource name this routed interface is attached to."
        },
        "router": {
          "type": "string",
          "description": "Router (IP-VRF) this routed interface belongs to."
        },
        "vlan_id": {
          "type": "string",
          "description": "VLAN ID for the sub-interface ('null' for untagged)."
        },
        "ip_mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 9500,
          "description": "IP MTU for the routed interface."
        },
        "arp_timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "ARP timeout in seconds."
        },
        "ipv4_addresses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ipPrefix"
            ],
            "additionalProperties": false,
            "properties": {
              "ipPrefix": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
                "description": "IPv4 prefix (e.g. '172.16.100.0/31')."
              },
              "primary": {
                "type": "boolean",
                "description": "Whether this is the primary address."
              }
            }
          },
          "description": "IPv4 addresses for this routed interface."
        }
      }
    },
    "staticRoute": {
      "type": "object",
      "required": [
        "name",
        "router",
        "nodes",
        "prefixes",
        "nexthop_group"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Static route resource name."
        },
        "router": {
          "type": "string",
          "description": "Router (IP-VRF) this static route belongs to."
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Nodes where this static route is applied."
        },
        "prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
          },
          "minItems": 1,
          "description": "Destination prefixes for this static route."
        },
        "nexthop_group": {
          "type": "object",
          "required": [
            "nexthops"
          ],
          "additionalProperties": false,
          "properties": {
            "blackhole": {
              "type": "boolean",
              "default": false,
              "description": "Whether this is a blackhole route."
            },
            "resolve": {
              "type": "boolean",
              "default": false,
              "description": "Enable recursive resolution."
            },
            "nexthops": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "ipPrefix"
                ],
                "additionalProperties": false,
                "properties": {
                  "ipPrefix": {
                    "type": "string",
                    "description": "Next-hop IP address."
                  },
                  "resolve": {
                    "type": "boolean",
                    "description": "Enable recursive resolution for this next-hop."
                  }
                }
              },
              "description": "Next-hop entries."
            }
          }
        }
      }
    },
    "extendedBridgeDomain": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Extended bridge domain with full field access for extras overrides.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Bridge domain name (must match an existing entry to override, or be new)."
        },
        "vni": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777215
        },
        "evi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "mac_learning": {
          "type": "boolean",
          "description": "Enable MAC learning."
        },
        "mac_aging": {
          "type": "integer",
          "minimum": 0,
          "description": "MAC aging timeout in seconds (0 = disabled)."
        },
        "mac_duplication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hold_down_time": {
              "type": "integer",
              "minimum": 0
            },
            "monitoring_window": {
              "type": "integer",
              "minimum": 1
            },
            "action": {
              "type": "string",
              "enum": [
                "StopLearning",
                "Blackhole",
                "UseNetInstanceAction"
              ]
            },
            "num_moves": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "export_target": {
          "type": "string",
          "pattern": "^target:.+$",
          "description": "Optional BGP-EVPN export route target. Overrides the default 'target:1:<evi>'."
        },
        "import_target": {
          "type": "string",
          "pattern": "^target:.+$",
          "description": "Optional BGP-EVPN import route target. Overrides the default 'target:1:<evi>'."
        }
      }
    },
    "extendedIrbInterface": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Extended IRB interface with full field access for extras overrides.",
      "properties": {
        "name": {
          "type": "string",
          "description": "IRB name (must match an existing entry to override, or be new)."
        },
        "bridge_domain": {
          "type": "string"
        },
        "router": {
          "type": "string"
        },
        "ipv4": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
        },
        "ip_addresses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "ipv4"
                ]
              },
              {
                "required": [
                  "ipv6"
                ]
              }
            ],
            "properties": {
              "ipv4": {
                "type": "object",
                "required": [
                  "ip_prefix"
                ],
                "additionalProperties": false,
                "properties": {
                  "ip_prefix": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
                  },
                  "primary": {
                    "type": "boolean"
                  }
                }
              },
              "ipv6": {
                "type": "object",
                "required": [
                  "ip_prefix"
                ],
                "additionalProperties": false,
                "properties": {
                  "ip_prefix": {
                    "type": "string"
                  },
                  "primary": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "description": {
          "type": "string"
        },
        "proxy_arp": {
          "type": "boolean"
        },
        "proxy_nd": {
          "type": "boolean"
        },
        "arp_timeout": {
          "type": "integer",
          "minimum": 1
        },
        "ip_mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 9500
        },
        "learn_unsolicited": {
          "type": "string",
          "enum": [
            "NONE",
            "GLOBAL"
          ]
        },
        "evpn_route_advertisement_type": {
          "type": "string",
          "enum": [
            "type5Only",
            "type2Only",
            "type2WithType5"
          ],
          "description": "EVPN route advertisement type."
        },
        "host_route_populate": {
          "type": "boolean",
          "description": "Populate host routes from ARP/ND entries."
        }
      }
    },
    "extendedRouter": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Extended router with full field access for extras overrides.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Router name (must match an existing entry to override, or be new)."
        },
        "vni": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777215,
          "description": "VXLAN Network Identifier."
        },
        "evi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "EVPN Instance identifier."
        },
        "node_selector": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_./-]+=.+$"
          },
          "minItems": 1,
          "description": "Label selectors to match nodes for this router."
        },
        "export_target": {
          "type": "string",
          "pattern": "^target:.+$",
          "description": "Optional BGP-EVPN export route target. Overrides the default 'target:1:<evi>'."
        },
        "import_target": {
          "type": "string",
          "pattern": "^target:.+$",
          "description": "Optional BGP-EVPN import route target. Overrides the default 'target:1:<evi>'."
        }
      }
    },
    "extendedVlan": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Extended VLAN with full field access for extras overrides.",
      "properties": {
        "name": {
          "type": "string",
          "description": "VLAN name (must match an existing entry to override, or be new)."
        },
        "bridge_domain": {
          "type": "string",
          "description": "Bridge domain this VLAN belongs to."
        },
        "vlan_id": {
          "type": "string",
          "pattern": "^(untagged|[0-9]+)$",
          "description": "VLAN ID ('untagged' or numeric string)."
        },
        "interface_selector": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_./-]+=.+$"
          },
          "minItems": 1,
          "description": "Label selectors to match interfaces for this VLAN."
        }
      }
    },
    "extendedRoutedInterface": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Extended routed interface with full field access for extras overrides.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Routed interface name (must match an existing entry to override, or be new)."
        },
        "interface": {
          "type": "string",
          "description": "Interface resource name."
        },
        "router": {
          "type": "string",
          "description": "Router (ip-vrf) this interface is bound to."
        },
        "vlan_id": {
          "type": "string",
          "description": "VLAN ID for the sub-interface ('null' for untagged)."
        },
        "ip_mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 9500,
          "description": "IP MTU for the routed interface."
        },
        "arp_timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "ARP timeout in seconds."
        },
        "ipv4_addresses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ipPrefix"
            ],
            "additionalProperties": false,
            "properties": {
              "ipPrefix": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
              },
              "primary": {
                "type": "boolean"
              }
            }
          },
          "description": "IPv4 address assignments."
        }
      }
    },
    "extendedStaticRoute": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Extended static route with full field access for extras overrides.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Static route name (must match an existing entry to override, or be new)."
        },
        "router": {
          "type": "string",
          "description": "Router (ip-vrf) for the static route."
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Nodes on which to install this route."
        },
        "prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
          },
          "description": "Destination prefixes."
        },
        "nexthop_group": {
          "type": "object",
          "required": [
            "nexthops"
          ],
          "additionalProperties": false,
          "properties": {
            "blackhole": {
              "type": "boolean",
              "default": false
            },
            "resolve": {
              "type": "boolean",
              "default": false
            },
            "nexthops": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "ipPrefix"
                ],
                "additionalProperties": false,
                "properties": {
                  "ipPrefix": {
                    "type": "string",
                    "description": "Next-hop IP address."
                  },
                  "resolve": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "routingPolicy": {
      "type": "object",
      "required": [
        "name",
        "statements"
      ],
      "additionalProperties": false,
      "description": "Routing policy definition. Overrides design-generated policy when name matches.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Routing policy name (e.g. 'ebgp-isl-export-policy-dc1')."
        },
        "default_action": {
          "type": "string",
          "enum": [
            "accept",
            "reject"
          ],
          "default": "reject",
          "description": "Action applied when no statement matches."
        },
        "statements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Statement identifier (e.g. '10', '25')."
              },
              "match": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prefix_set": {
                    "type": "string",
                    "description": "Reference to a PrefixSet by name."
                  },
                  "protocol": {
                    "type": "string",
                    "enum": [
                      "local",
                      "bgp",
                      "aggregate",
                      "bgp_evpn",
                      "static"
                    ],
                    "description": "Source protocol to match."
                  },
                  "bgp_evpn_route_types": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "description": "BGP EVPN route types (subset of 1..5)."
                  }
                }
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "result": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "reject"
                    ],
                    "default": "accept"
                  },
                  "set_local_preference": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
