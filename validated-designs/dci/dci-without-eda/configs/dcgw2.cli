set / network-instance ipvrf-l3dci type ip-vrf
set / network-instance ipvrf-l3dci admin-state enable
set / network-instance ipvrf-l3dci description "L3 DCI gateway - IFL Type-5 vxlan<->ip-vpn stitch"
set / network-instance ipvrf-l3dci vxlan-interface vxlan0.3000
set / network-instance ipvrf-l3dci protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance ipvrf-l3dci protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan0.3000
set / network-instance ipvrf-l3dci protocols bgp-evpn bgp-instance 1 evi 3000
set / network-instance ipvrf-l3dci protocols bgp-evpn bgp-instance 1 ecmp 8
set / network-instance ipvrf-l3dci protocols bgp-evpn bgp-instance 1 internal-tags set-tag-set [ tag-1 ]
# D-PATH loop prevention (draft-ietf-bess-evpn-ipvpn-interworking): DC1 EVPN
# domain = 65000:1, shared WAN IP-VPN domain = 65000:100. A route re-originated
# into DC1 by this GW and re-injected toward the WAN by the peer DC1 GW carries
# the WAN domain-id and is detected as a loop (made inactive) on re-import.
set / network-instance ipvrf-l3dci protocols bgp-evpn bgp-instance 1 dpath-domain-id 65000:1
set / network-instance ipvrf-l3dci protocols bgp-ipvpn bgp-instance 2 admin-state enable
set / network-instance ipvrf-l3dci protocols bgp-ipvpn bgp-instance 2 dpath-domain-id 65000:100
set / network-instance ipvrf-l3dci protocols bgp-ipvpn bgp-instance 2 encapsulation-type mpls
set / network-instance ipvrf-l3dci protocols bgp-ipvpn bgp-instance 2 ecmp 8
set / network-instance ipvrf-l3dci protocols bgp-ipvpn bgp-instance 2 internal-tags set-tag-set [ tag-2 ]
set / network-instance ipvrf-l3dci protocols bgp-ipvpn bgp-instance 2 mpls next-hop-resolution allowed-tunnel-types [ ldp sr-isis ]
set / network-instance ipvrf-l3dci protocols bgp-vpn bgp-instance 1 route-distinguisher rd 192.0.2.152:3000
set / network-instance ipvrf-l3dci protocols bgp-vpn bgp-instance 1 route-target export-rt target:3000:3000
set / network-instance ipvrf-l3dci protocols bgp-vpn bgp-instance 1 route-target import-rt target:3000:3000
set / network-instance ipvrf-l3dci protocols bgp-vpn bgp-instance 2 route-distinguisher rd 192.0.2.152:13000
set / network-instance ipvrf-l3dci protocols bgp-vpn bgp-instance 2 route-target export-rt target:65000:3000
set / network-instance ipvrf-l3dci protocols bgp-vpn bgp-instance 2 route-target import-rt target:65000:3000
set / routing-policy tag-set tag-1 tag-value [ 1 ]
set / routing-policy tag-set tag-2 tag-value [ 2 ]
set / routing-policy extended-community-set soo-dc1 member [ origin:65000:1 ]
set / routing-policy prefix-set prefixset-dc1 prefix 192.0.2.0/24 mask-length-range 32..32
# L3-DCI host-route scaling: local DCGWs install the /32 (/128) arp-nd host-routes
# learned from the local DC fabric (anti-trombone), but they MUST NOT be re-originated
# over the WAN IP-VPN - only the /24 subnet crosses the DCI. This set matches all
# tenant host-routes and is rejected on WAN export (dcgw-wan-export-dc1 statement 8).
set / routing-policy prefix-set host-routes-l3dci prefix 10.200.0.0/16 mask-length-range 32..32
set / routing-policy prefix-set host-routes-l3dci prefix ::/0 mask-length-range 128..128
# per-service L2 gateway load-sharing: this gateway is PRIMARY for BD-B. It de-prefers
# BD-A on BOTH DCI planes so BD-A rides the peer gateway (dcgw1 in DC1, dcgw3 in DC2)
# in steady state, while BD-B rides dcgw2/dcgw4:
#   - DC/VXLAN (eBGP fabric): AS-path prepend on the BD-A DC route-target (dc-export
#     statement 12) - local-pref is not honoured across the eBGP fabric.
#   - WAN/MPLS (iBGP core): lower local-preference on the BD-A WAN route-target
#     (wan-export statement 15) - AS-path prepend cannot be used on the iBGP core
#     (the peer DCGW would drop the route as an own-AS loop and lose the standby path).
# Both keep the de-preferred path present as a hot standby (no EVPN re-origination is
# suppressed, unlike an instance-level bgp-vpn export-policy).
set / routing-policy extended-community-set rt-l2dci-a member [ target:100:100 ]
set / routing-policy extended-community-set rt-l2dci-b member [ target:110:110 ]
set / routing-policy extended-community-set rt-wan-l2dci-a member [ target:65000:100 ]
set / routing-policy extended-community-set rt-wan-l2dci-b member [ target:65000:110 ]
set / routing-policy policy dcgw-dc-export-dc1 default-action policy-result reject
set / routing-policy policy dcgw-dc-export-dc1 statement 5 match protocol local
set / routing-policy policy dcgw-dc-export-dc1 statement 5 match prefix prefix-set prefixset-dc1
set / routing-policy policy dcgw-dc-export-dc1 statement 5 action policy-result accept
set / routing-policy policy dcgw-dc-export-dc1 statement 10 match family [ evpn ]
set / routing-policy policy dcgw-dc-export-dc1 statement 10 match internal-tags tag-set [ tag-2 ]
set / routing-policy policy dcgw-dc-export-dc1 statement 10 action policy-result reject
set / routing-policy policy dcgw-dc-export-dc1 statement 12 match family [ evpn ]
set / routing-policy policy dcgw-dc-export-dc1 statement 12 match bgp extended-community extended-community-set rt-l2dci-a
set / routing-policy policy dcgw-dc-export-dc1 statement 12 action bgp as-path prepend as-number 65000 repeat-n 2
set / routing-policy policy dcgw-dc-export-dc1 statement 12 action bgp extended-community operation add
set / routing-policy policy dcgw-dc-export-dc1 statement 12 action bgp extended-community referenced-sets [ soo-dc1 ]
set / routing-policy policy dcgw-dc-export-dc1 statement 12 action policy-result accept
set / routing-policy policy dcgw-dc-export-dc1 statement 15 match family [ evpn ]
set / routing-policy policy dcgw-dc-export-dc1 statement 15 action policy-result accept
set / routing-policy policy dcgw-dc-export-dc1 statement 15 action bgp extended-community operation add
set / routing-policy policy dcgw-dc-export-dc1 statement 15 action bgp extended-community referenced-sets [ soo-dc1 ]
set / routing-policy policy dcgw-dc-export-dc1 statement 20 match protocol bgp
set / routing-policy policy dcgw-dc-export-dc1 statement 20 action policy-result accept
set / routing-policy policy dcgw-dc-import-dc1 default-action policy-result reject
set / routing-policy policy dcgw-dc-import-dc1 statement 10 match family [ evpn ]
set / routing-policy policy dcgw-dc-import-dc1 statement 10 match bgp extended-community extended-community-set soo-dc1
set / routing-policy policy dcgw-dc-import-dc1 statement 10 action policy-result reject
set / routing-policy policy dcgw-dc-import-dc1 statement 20 match family [ evpn ]
set / routing-policy policy dcgw-dc-import-dc1 statement 20 action policy-result accept
set / routing-policy policy dcgw-dc-import-dc1 statement 20 action internal-tags set-tag-set [ tag-1 ]
set / routing-policy policy dcgw-dc-import-dc1 statement 30 match family [ ipv4-unicast ]
set / routing-policy policy dcgw-dc-import-dc1 statement 30 action policy-result accept
set / routing-policy policy dcgw-dc-import-dc1 statement 40 match family [ ipv6-unicast ]
