{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unconstrained-3-stage/topology.fragment",
  "title": "Unconstrained 3-Stage Fabric \u2014 Topology Schema (fragment)",
  "description": "Full-coverage topology schema for a 3-stage Clos fabric. Every EDA API resource field is directly configurable. Fragment variant: top-level required keys removed so individual fragments under inputs/*.d/ validate cleanly. The merged result is still validated against the strict schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "design": {
      "type": "string",
      "const": "unconstrained-3-stage",
      "description": "Design identifier."
    },
    "fabric_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Fabric resource name."
    },
    "environment": {
      "type": "string",
      "enum": [
        "containerlab",
        "physical"
      ],
      "default": "containerlab"
    },
    "credentials": {
      "$ref": "#/$defs/credentials"
    },
    "mgmt_subnet": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
      "description": "Management network subnet (informational / used by clab generator)."
    },
    "underlay": {
      "type": "object",
      "required": [
        "spine_asn",
        "leaf_asn_start",
        "system0_prefix"
      ],
      "additionalProperties": false,
      "properties": {
        "spine_asn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "BGP AS number for spines."
        },
        "spine_asn_pool_size": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Spine ASN allocation pool size."
        },
        "leaf_asn_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Starting BGP AS number for leafs."
        },
        "leaf_asn_pool_size": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Leaf ASN allocation pool size."
        },
        "system0_prefix": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
          "description": "IPv4 prefix for system0 loopback allocation."
        }
      }
    },
    "fabric": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mirror of the EDA Fabric spec (fabrics_eda_nokia_com_v1alpha1.json). Each block maps 1:1 to its camelCase EDA counterpart (underlay_protocol \u2192 underlayProtocol, etc.).",
      "properties": {
        "underlay_protocol": {
          "$ref": "#/$defs/underlayProtocol"
        },
        "overlay_protocol": {
          "$ref": "#/$defs/overlayProtocol"
        },
        "inter_switch_links": {
          "$ref": "#/$defs/interSwitchLinks"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "overlay_protocol": {
                "properties": {
                  "protocol": {
                    "const": "IBGP"
                  }
                },
                "required": [
                  "protocol"
                ]
              }
            },
            "required": [
              "overlay_protocol"
            ]
          },
          "then": {
            "properties": {
              "overlay_protocol": {
                "required": [
                  "bgp"
                ],
                "properties": {
                  "bgp": {
                    "required": [
                      "autonomous_system",
                      "cluster_id"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      },
      "description": "Individual node definitions."
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/link"
      },
      "description": "Inter-switch links."
    },
    "edge_interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edgeInterface"
      },
      "description": "Server-facing edge interfaces."
    },
    "lags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lag"
      },
      "description": "LAG interfaces."
    },
    "configlets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configlet"
      },
      "description": "Raw SR Linux configlet patches."
    },
    "default_mtu": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/defaultMtu"
      },
      "description": "Default MTU settings for fabric nodes."
    },
    "banners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/banner"
      },
      "description": "Login and MOTD banner settings for fabric nodes."
    },
    "prefix_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prefixSet"
      },
      "description": "Prefix sets referenced by routing_policies in services.yaml."
    },
    "fabric_export_policies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of routing_policies to attach as fabric-wide export policies on the Fabric CR."
    },
    "fabric_import_policies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of routing_policies to attach as fabric-wide import policies on the Fabric CR."
    },
    "eda": {
      "$ref": "#/$defs/eda"
    }
  },
  "$defs": {
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "description": "Device credentials used for node onboarding and by generated artefacts (clab, Ansible, gnmic).",
      "properties": {
        "username": {
          "type": "string",
          "default": "admin",
          "description": "Device username."
        },
        "password": {
          "type": "string",
          "default": "NokiaSrl1!",
          "description": "Device password."
        }
      }
    },
    "eda": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_profile": {
          "type": "string",
          "description": "EDA NodeProfile name for node onboarding."
        },
        "namespace": {
          "type": "string",
          "default": "eda",
          "description": "EDA namespace for all resources."
        }
      }
    },
    "labels": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_./-]+$": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Kubernetes-style label key/value pairs."
    },
    "bfd": {
      "type": "object",
      "additionalProperties": false,
      "description": "BFD timers; fields and ranges mirror the EDA underlay/overlay BFD sub-schema.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "desired_min_transmit_int": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 100000000
        },
        "required_min_receive": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 100000000
        },
        "detection_multiplier": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        },
        "min_echo_receive_interval": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "ttl": {
          "type": "integer",
          "minimum": 2,
          "maximum": 255
        }
      }
    },
    "bgpTimers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connect_retry": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hold_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "keep_alive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21845
        },
        "minimum_advertisement_interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "underlayProtocol": {
      "type": "object",
      "additionalProperties": false,
      "description": "Underlay routing protocol(s) used between ISL peers.",
      "properties": {
        "protocol": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "EBGP",
              "OSPFv2",
              "OSPFv3"
            ]
          },
          "description": "List of underlay protocols. Multiple may be combined (e.g. [EBGP, OSPFv2]); OSPFv2 and OSPFv3 are mutually exclusive."
        },
        "bgp": {
          "type": "object",
          "additionalProperties": false,
          "description": "Underlay BGP-specific options (used when protocol contains EBGP).",
          "properties": {
            "asn_pool": {
              "type": "string",
              "description": "Reference to an IndexAllocationPool. Defaults to the design's auto-generated pool when omitted."
            },
            "export_policy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "import_policy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "keychain": {
              "type": "string"
            },
            "timers": {
              "$ref": "#/$defs/bgpTimers"
            }
          }
        },
        "ospf": {
          "type": "object",
          "additionalProperties": false,
          "description": "Underlay OSPF-specific options (used when protocol contains OSPFv2 or OSPFv3).",
          "properties": {
            "address_family": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "IPV4-UNICAST",
                  "IPV6-UNICAST"
                ]
              },
              "description": "OSPFv3-only: enabled address families. Both are enabled by default."
            }
          }
        },
        "bfd": {
          "$ref": "#/$defs/bfd"
        }
      },
      "required": [
        "protocol"
      ]
    },
    "overlayProtocol": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overlay protocol used to advertise EVPN routes.",
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "IBGP",
            "EBGP"
          ],
          "description": "EBGP reuses the underlay BGP sessions; IBGP builds dedicated route-reflector / client peerings."
        },
        "bgp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autonomous_system": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295,
              "description": "Required when overlay protocol is IBGP."
            },
            "cluster_id": {
              "type": "string",
              "description": "Required when overlay protocol is IBGP."
            },
            "export_policy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "import_policy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "keychain": {
              "type": "string"
            },
            "rr_node_selector": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Label selectors for route reflectors. Defaults to spine selectors when omitted."
            },
            "rr_client_node_selector": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Label selectors for route-reflector clients. Defaults to leaf selectors when omitted."
            },
            "rr_ip_addresses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "timers": {
              "$ref": "#/$defs/bgpTimers"
            }
          }
        },
        "bfd": {
          "$ref": "#/$defs/bfd"
        }
      },
      "required": [
        "protocol"
      ]
    },
    "interSwitchLinks": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inter-switch-link wiring options on the Fabric CR.",
      "properties": {
        "unnumbered": {
          "type": "string",
          "enum": [
            "IPV6"
          ],
          "description": "EDA only supports IPV6 link-local unnumbered today. Omit and provide pool_ipv4 for IPv4-numbered ISLs."
        },
        "pool_ipv4": {
          "type": "string",
          "description": "Name of a SubnetAllocationPool used for IPv4-numbered ISLs. Mutually exclusive with unnumbered."
        },
        "pool_ipv6": {
          "type": "string",
          "description": "Name of a SubnetAllocationPool used for IPv6 global ISL addresses. Compatible with unnumbered=IPV6 for dual-stack."
        },
        "ip_mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 9486
        },
        "vlan_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        }
      },
      "not": {
        "required": [
          "unnumbered",
          "pool_ipv4"
        ]
      }
    },
    "node": {
      "type": "object",
      "required": [
        "name",
        "role",
        "platform",
        "version",
        "asn",
        "system0_ipv4",
        "mgmt_ipv4"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Node name (must be unique)."
        },
        "role": {
          "type": "string",
          "enum": [
            "leaf",
            "spine"
          ],
          "description": "Node role."
        },
        "platform": {
          "type": "string",
          "description": "Nokia SR Linux platform model."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "SR Linux software version."
        },
        "asn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "BGP AS number for this node."
        },
        "system0_ipv4": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
          "description": "System0 loopback IPv4 address with prefix."
        },
        "mgmt_ipv4": {
          "type": "string",
          "format": "ipv4",
          "description": "Management IPv4 address."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "uplink_interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Uplink interface names (informational)."
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "name",
        "local_node",
        "local_interface",
        "remote_node",
        "remote_interface"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Link resource name."
        },
        "local_node": {
          "type": "string"
        },
        "local_interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+(-[0-9]+)?$",
          "description": "Local interface (supports breakout syntax)."
        },
        "remote_node": {
          "type": "string"
        },
        "remote_interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+(-[0-9]+)?$",
          "description": "Remote interface (supports breakout syntax)."
        }
      }
    },
    "edgeInterface": {
      "type": "object",
      "required": [
        "name",
        "node",
        "interface",
        "encap"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique interface resource name."
        },
        "node": {
          "type": "string",
          "description": "Node this interface belongs to."
        },
        "interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+$",
          "description": "Physical interface name (e.g. 'ethernet-1-3')."
        },
        "encap": {
          "type": "string",
          "enum": [
            "dot1q",
            "null"
          ],
          "description": "Encapsulation type."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "lag": {
      "type": "object",
      "required": [
        "name",
        "type",
        "mode",
        "min_links",
        "lacp",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique LAG resource name."
        },
        "type": {
          "type": "string",
          "enum": [
            "lacp"
          ],
          "description": "LAG type."
        },
        "mode": {
          "type": "string",
          "enum": [
            "all-active",
            "port-active"
          ],
          "description": "ESI multi-homing mode."
        },
        "min_links": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum active links."
        },
        "revertive": {
          "type": "boolean",
          "description": "Enable revertive behavior (port-active only)."
        },
        "preferred_active_node": {
          "type": "string",
          "description": "Preferred active node for port-active LAGs."
        },
        "standby_signaling": {
          "type": "string",
          "enum": [
            "lacp"
          ],
          "description": "Standby signaling method."
        },
        "lacp": {
          "type": "object",
          "required": [
            "interval",
            "system_id_mac",
            "system_priority"
          ],
          "additionalProperties": false,
          "properties": {
            "interval": {
              "type": "string",
              "enum": [
                "fast",
                "slow"
              ],
              "description": "LACP PDU interval."
            },
            "system_id_mac": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$",
              "description": "LACP system ID MAC address."
            },
            "system_priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "description": "LACP system priority."
            },
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "static"
                  ],
                  "description": "LACP fallback mode."
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Fallback timeout in seconds."
                }
              }
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "node",
              "interface",
              "aggregate_id"
            ],
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "description": "Member node name."
              },
              "interface": {
                "type": "string",
                "description": "Member interface name."
              },
              "aggregate_id": {
                "type": "string",
                "description": "LAG aggregate ID."
              }
            }
          },
          "description": "LAG member interfaces."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "reload_delay_timer": {
          "type": "integer",
          "minimum": 0,
          "description": "Reload delay timer in seconds."
        }
      }
    },
    "configlet": {
      "type": "object",
      "required": [
        "name",
        "configs"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Configlet resource name."
        },
        "endpoint_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label selectors to match target nodes."
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit list of target node names."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 100,
          "description": "Configlet priority (higher = applied later)."
        },
        "configs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "operation",
              "config"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "JSON path in the SR Linux YANG model."
              },
              "operation": {
                "type": "string",
                "enum": [
                  "Create",
                  "Update",
                  "Delete"
                ],
                "description": "Config operation type."
              },
              "config": {
                "type": "string",
                "description": "JSON config payload as a string."
              }
            }
          }
        }
      }
    },
    "defaultMtu": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique DefaultMTU resource name."
        },
        "interface_mtu": {
          "type": "integer",
          "minimum": 1500,
          "maximum": 11000,
          "description": "Default MTU for Ethernet interfaces (includes Ethernet headers, excludes 4-byte FCS trailer)."
        },
        "layer2_subif_mtu": {
          "type": "integer",
          "minimum": 1500,
          "maximum": 11000,
          "description": "Default MTU for Layer 2 (bridged) sub-interfaces."
        },
        "layer3_mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 11000,
          "description": "Default IP MTU for Layer 3 interfaces."
        },
        "node_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label selector to select nodes on which to configure the defaults."
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit list of nodes on which to configure the defaults."
        }
      }
    },
    "banner": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique Banner resource name."
        },
        "login_banner": {
          "type": "string",
          "description": "Login banner displayed before a user has logged into the node."
        },
        "motd": {
          "type": "string",
          "description": "Message of the Day displayed after a user has logged into the node."
        },
        "node_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label selector to select nodes on which to configure the banners."
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit list of nodes on which to configure the banners."
        }
      }
    },
    "prefixSet": {
      "type": "object",
      "required": [
        "name",
        "prefixes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique prefix-set name."
        },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ip_prefix"
            ],
            "additionalProperties": false,
            "properties": {
              "ip_prefix": {
                "type": "string",
                "description": "IPv4 or IPv6 prefix in CIDR notation."
              },
              "mask_length_range": {
                "type": "string",
                "default": "exact",
                "description": "Mask-length range (e.g. '32..32', 'exact')."
              }
            }
          }
        }
      }
    }
  }
}
