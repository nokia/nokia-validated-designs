{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common/topology-defs",
  "title": "Shared Topology Schema Definitions",
  "description": "Reusable $defs for topology schemas across all NVD designs.",
  "$defs": {
    "labels": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_./-]+$": { "type": "string" }
      },
      "additionalProperties": false,
      "description": "Kubernetes-style label key/value pairs."
    },
    "edgeInterface": {
      "type": "object",
      "required": ["name", "node", "interface", "encap"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique interface resource name."
        },
        "node": {
          "type": "string",
          "description": "Node this interface belongs to."
        },
        "interface": {
          "type": "string",
          "pattern": "^ethernet-[0-9]+-[0-9]+$",
          "description": "Physical interface name (e.g. 'ethernet-1-3')."
        },
        "encap": {
          "type": "string",
          "enum": ["dot1q", "null"],
          "description": "Encapsulation type."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "lag": {
      "type": "object",
      "required": ["name", "type", "mode", "min_links", "lacp", "members"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique LAG resource name."
        },
        "type": {
          "type": "string",
          "enum": ["lacp"],
          "description": "LAG type."
        },
        "mode": {
          "type": "string",
          "enum": ["all-active", "port-active"],
          "description": "ESI multi-homing mode."
        },
        "min_links": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum active links."
        },
        "revertive": {
          "type": "boolean",
          "description": "Enable revertive behavior (port-active only)."
        },
        "preferred_active_node": {
          "type": "string",
          "description": "Preferred active node for port-active LAGs."
        },
        "standby_signaling": {
          "type": "string",
          "enum": ["lacp"],
          "description": "Standby signaling method."
        },
        "lacp": {
          "type": "object",
          "required": ["interval", "system_id_mac", "system_priority"],
          "additionalProperties": false,
          "properties": {
            "interval": {
              "type": "string",
              "enum": ["fast", "slow"],
              "description": "LACP PDU interval."
            },
            "system_id_mac": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$",
              "description": "LACP system ID MAC address."
            },
            "system_priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "description": "LACP system priority."
            },
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["static"],
                  "description": "LACP fallback mode."
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Fallback timeout in seconds."
                }
              }
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["node", "interface", "aggregate_id"],
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "description": "Member node name."
              },
              "interface": {
                "type": "string",
                "description": "Member interface name."
              },
              "aggregate_id": {
                "type": "string",
                "description": "LAG aggregate ID."
              }
            }
          },
          "description": "LAG member interfaces."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "reload_delay_timer": {
          "type": "integer",
          "minimum": 0,
          "description": "Reload delay timer in seconds."
        }
      }
    },
    "defaultMtu": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique DefaultMTU resource name."
        },
        "interface_mtu": {
          "type": "integer",
          "minimum": 1500,
          "maximum": 11000,
          "description": "Default MTU for Ethernet interfaces (includes Ethernet headers, excludes 4-byte FCS trailer)."
        },
        "layer2_subif_mtu": {
          "type": "integer",
          "minimum": 1500,
          "maximum": 11000,
          "description": "Default MTU for Layer 2 (bridged) sub-interfaces."
        },
        "layer3_mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 11000,
          "description": "Default IP MTU for Layer 3 interfaces."
        },
        "node_selector": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Label selector to select nodes on which to configure the defaults."
        },
        "nodes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit list of nodes on which to configure the defaults."
        }
      }
    },
    "banner": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique Banner resource name."
        },
        "login_banner": {
          "type": "string",
          "description": "Login banner displayed before a user has logged into the node."
        },
        "motd": {
          "type": "string",
          "description": "Message of the Day displayed after a user has logged into the node."
        },
        "node_selector": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Label selector to select nodes on which to configure the banners."
        },
        "nodes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit list of nodes on which to configure the banners."
        }
      }
    },
    "configlet": {
      "type": "object",
      "required": ["name", "configs"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Configlet resource name."
        },
        "endpoint_selector": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Label selectors to match target nodes."
        },
        "endpoints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit list of target node names."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 100,
          "description": "Configlet priority (higher = applied later)."
        },
        "configs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "operation", "config"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "JSON path in the SR Linux YANG model."
              },
              "operation": {
                "type": "string",
                "enum": ["Create", "Update", "Delete"],
                "description": "Config operation type."
              },
              "config": {
                "type": "string",
                "description": "JSON config payload as a string."
              }
            }
          }
        }
      }
    },
    "eda": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_profile": {
          "type": "string",
          "description": "EDA NodeProfile name for node onboarding."
        },
        "namespace": {
          "type": "string",
          "default": "eda",
          "description": "EDA namespace for all resources."
        }
      }
    }
  }
}
